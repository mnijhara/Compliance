# ComplyOS AI production router
# Gemini keys stay inside the Cloudflare Worker and must never be committed here.
AI_PROXY_URL=https://getjobready-ai-proxy.mnijhara.workers.dev
GEMINI_MODEL=gemini-3.7-flash

# Sensitive production API routes fail closed unless tenant-scoped credentials are configured.
# Store SHA-256 hashes of long random bearer tokens, never the raw tokens.
# Example shape: [{"tokenHash":"<64-char-lowercase-sha256>","tenantId":"tenant-acme","subject":"user-123","roles":["admin"]}]
COMPLYOS_API_TOKENS_JSON=

# Optional durable persistence wiring. Do not put bearer access tokens here.
# The application must provide a request-scoped access-token provider so Supabase RLS
# evaluates the authenticated caller's tenant_id claim.
COMPLYOS_PERSISTENCE=memory
SUPABASE_URL=
SUPABASE_ANON_KEY=
