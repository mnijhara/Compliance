# ComplyOS AI production router
# Gemini keys stay inside the Cloudflare Worker and must never be committed here.
AI_PROXY_URL=https://getjobready-ai-proxy.mnijhara.workers.dev
GEMINI_MODEL=gemini-3.7-flash

# Sensitive production API routes fail closed unless this is configured.
# Use a randomly generated secret of at least 32 characters; never commit the value.
COMPLYOS_API_TOKEN=
